{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "site",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "site",
        "--",
        "--port",
        "4180",
        "--strictPort"
      ],
      "port": 4180
    }
  ]
}
